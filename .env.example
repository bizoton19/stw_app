OPENROUTER_API_KEY=

# Optional vision model override (default google/gemini-2.5-flash)
# OPENROUTER_VISION_MODEL=

# Public site URL shown to OpenRouter / referer header
# OPENROUTER_HTTP_REFERER=https://your-app.up.railway.app

# Comma-separated browser origins allowed to call /api (native apps ignore CORS).
# Leave unset in local dev. Set on Railway for friend-test / prod.
# ALLOWED_ORIGINS=https://your-app.up.railway.app

# Shared Railway Postgres. When set, receipts persist in schema `split_the_wine`
# (other apps on the same instance should use their own schemas).
# DATABASE_URL=postgresql://...

# Seed /r/demo in production (default: only outside production)
# ALLOW_DEMO=1
