OPENROUTER_API_KEY=

# Optional vision model override (default google/gemini-2.5-flash)
# OPENROUTER_VISION_MODEL=

# Public site URL shown to OpenRouter / referer header
# OPENROUTER_HTTP_REFERER=https://your-app.up.railway.app

# Comma-separated browser origins allowed to call /api (native apps ignore CORS).
# Leave unset in local dev. Set on Railway for friend-test / prod.
# ALLOWED_ORIGINS=https://your-app.up.railway.app

# Shared Railway Postgres. When set, receipts persist in schema `split_the_wine`
# (other apps on the same instance should use their own schemas).
# DATABASE_URL=postgresql://...

# Receipt photo blobs — any S3-compatible store (Railway Buckets, Cloudflare R2, AWS S3).
# When set, Postgres keeps only metadata (mime, size, storage_key); bytes live in the bucket.
# Swap providers by changing these vars — no code change.
# Railway Bucket → Credentials tab / `railway bucket credentials`
# OBJECT_STORAGE_BUCKET=receipt-images-xxxxx
# OBJECT_STORAGE_ENDPOINT=https://t3.storageapi.dev
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Also accepts AWS_* / R2_* aliases (AWS_S3_BUCKET_NAME, AWS_ENDPOINT_URL, …).

# Seed /r/demo in production (default: only outside production)
# ALLOW_DEMO=1

# Mapbox Search Box — Android + web venue typeahead (iOS uses on-device MapKit).
# Create a token at https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=pk.eyJ...
