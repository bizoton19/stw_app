# Vision provider: gemini | openrouter (optional). Unset = first configured key (gemini, then openrouter).
# VISION_PROVIDER=gemini

# Google AI Studio / Gemini API (server-side receipt vision)
GEMINI_API_KEY=

# Optional Gemini model override (default gemini-3.5-flash-lite)
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Extra classify-before-parse Gemini call (off by default — host uploads skip it).
# VISION_CLASSIFY=1

# OpenRouter fallback (optional)
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Prod: https://api.splitthewine.app · Dev: https://apidev.splitthewine.app
# OPENROUTER_HTTP_REFERER=https://apidev.splitthewine.app

# Comma-separated browser origins allowed to call /api (native apps ignore CORS).
# Leave unset in local dev. Set on Railway for friend-test / prod.
# Include the marketing site so /coming-soon can POST /api/waitlist.
# ALLOWED_ORIGINS=https://apidev.splitthewine.app,https://api.splitthewine.app,https://www.splitthewine.app

# Shared Railway Postgres. When set, receipts persist in schema `split_the_wine`
# (other apps on the same instance should use their own schemas).
# DATABASE_URL=postgresql://...

# Postgres schema for this app (default split_the_wine).
# Use split_the_wine_dev on Railway service api-dev / apidev.splitthewine.app so prod stays untouched.
# DB_SCHEMA=split_the_wine_dev

# Daily DIY backups: see plans/db-backups.md + .github/workflows/db-backup.yml
# (pg_dump of schema split_the_wine → this same object bucket under db-backups/)

# Receipt photo blobs — any S3-compatible store (Railway Buckets, Cloudflare R2, AWS S3).
# When set, Postgres keeps only metadata (mime, size, storage_key); bytes live in the bucket.
# Swap providers by changing these vars — no code change.
# Railway Bucket → Credentials tab / `railway bucket credentials`
# OBJECT_STORAGE_BUCKET=receipt-images-xxxxx
# OBJECT_STORAGE_ENDPOINT=https://t3.storageapi.dev
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false
# Also accepts AWS_* / R2_* aliases (AWS_S3_BUCKET_NAME, AWS_ENDPOINT_URL, …).
# BACKUP_RETENTION_DAYS=14

# Seed /r/demo in production (default: only outside production)
# ALLOW_DEMO=1

# Google Places API (New) — server only. Nearby search, photo proxy, and the
# typeahead → place_id bridge (Text Search by name + lat/lng).
# Never put this in Expo, NEXT_PUBLIC_*, or any web/client bundle.
# Leave unset until a real Places API (New) key exists. The proxy fails closed
# (clear 503, no Google call) when this is missing or blank.
# GOOGLE_PLACES_API_KEY=

# Mapbox Search Box — Android + web venue typeahead (iOS uses on-device MapKit).
# Copy the default public token (pk.) from https://account.mapbox.com/access-tokens/
# No Geocoding product, no custom Styles setup, no URL restrictions — server calls
# Search Box suggest/retrieve (and optional Static Images) with that default token.
# If autocomplete returns places_unauthorized, the token was revoked — paste a new pk.
# MAPBOX_ACCESS_TOKEN=pk.eyJ...
