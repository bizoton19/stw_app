# Leave empty to infer the API host from Expo (the same LAN IP as Metro).
# A physical phone cannot use localhost — set this to the Mac running Next.js:
# EXPO_PUBLIC_API_URL=http://192.168.1.12:43147
# Prod: https://api.splitthewine.app
# Dev / Plan-an-outing: https://apidev.splitthewine.app (or api-dev-production-*.up.railway.app until cert is ready)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SHARE_URL=
