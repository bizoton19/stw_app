{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "dev",
        "EXPO_PUBLIC_SHOW_API_STATUS": "1",
        "EXPO_PUBLIC_API_URL": "https://api-dev-production-c2d1.up.railway.app",
        "EXPO_PUBLIC_SHARE_URL": "https://api-dev-production-c2d1.up.railway.app"
      }
    },
    "dev": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "dev",
      "env": {
        "APP_VARIANT": "dev",
        "EXPO_PUBLIC_SHOW_API_STATUS": "1",
        "EXPO_PUBLIC_API_URL": "https://api-dev-production-c2d1.up.railway.app",
        "EXPO_PUBLIC_SHARE_URL": "https://api-dev-production-c2d1.up.railway.app"
      }
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.splitthewine.app",
        "EXPO_PUBLIC_SHARE_URL": "https://api.splitthewine.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.splitthewine.app",
        "EXPO_PUBLIC_SHARE_URL": "https://api.splitthewine.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6814806172"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6814806172"
      }
    }
  }
}
