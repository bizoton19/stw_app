{
  "expo": {
    "name": "Split the Wine",
    "slug": "split-the-wine",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitthewine",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.splitthewine.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Split the Wine photographs the check so the server can read the lines. You still review every item.",
        "NSPhotoLibraryUsageDescription": "Split the Wine reads a receipt photo from your library so the server can extract the tab.",
        "NSPhotoLibraryAddUsageDescription": "Split the Wine only reads photos; it does not save to your library.",
        "LSApplicationQueriesSchemes": [
          "venmo",
          "cashme",
          "cashapp",
          "paypal",
          "paypalme"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.splitthewine.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6F4F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Split the Wine reads a receipt photo so the server can extract the tab.",
          "cameraPermission": "Split the Wine photographs the check so the server can read the lines."
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "fr",
              "de",
              "pt",
              "it",
              "ja",
              "zh-Hans",
              "zh-Hant",
              "ko"
            ],
            "android": [
              "en",
              "es",
              "fr",
              "de",
              "pt",
              "it",
              "ja",
              "zh",
              "ko"
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9dffe8e-7f60-4ad0-a74d-87bdeae1dd4c"
      }
    },
    "owner": "bizoton19"
  }
}
